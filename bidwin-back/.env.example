# Spring은 .env를 자동으로 읽지 않습니다. 로컬 셸/IDE/배포 환경에 아래 값을 주입하세요.

# Database
DB_URL=jdbc:mysql://localhost:3306/bidwin?connectionTimeZone=%2B09:00&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=
# 기존 ddl-auto 스키마가 V1과 동일할 때만 처음 true로 실행한 뒤 false로 되돌립니다.
FLYWAY_BASELINE_ON_MIGRATE=false

# Session
SESSION_COOKIE_SECURE=false

# Mail
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_RATE_LIMIT_COOLDOWN=1m
MAIL_RATE_LIMIT_WINDOW=15m
MAIL_RATE_LIMIT_MAX_COUNT=5
PASSWORD_RESET_URL=http://localhost:5173/password-reset/confirm
EMAIL_VERIFICATION_URL=http://localhost:5173/email-verification

# Auction scheduler
AUCTION_CLOSING_INTERVAL=1s
AUCTION_CLOSING_BATCH_SIZE=100

# SSE
SSE_CONNECTION_TIMEOUT_MS=300000
SSE_HEARTBEAT_INTERVAL_MS=15000
SSE_RECONNECT_TIME_MS=3000
SSE_MAX_CHANNELS_PER_CONNECTION=50
SSE_MAX_PENDING_MESSAGES_PER_CONNECTION=100
SSE_MAX_CONNECTIONS=1000

# Object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_S3_PRESIGN_DURATION=5m
AWS_CLOUDFRONT_DOMAIN=http://localhost:8080
PENDING_AUCTION_IMAGE_RETENTION=24h
PENDING_AUCTION_IMAGE_CLEANUP_INTERVAL=1h
PENDING_AUCTION_IMAGE_CLEANUP_BATCH_SIZE=1000
PENDING_PROFILE_IMAGE_RETENTION=24h
PENDING_PROFILE_IMAGE_CLEANUP_INTERVAL=1h
PENDING_PROFILE_IMAGE_CLEANUP_BATCH_SIZE=100

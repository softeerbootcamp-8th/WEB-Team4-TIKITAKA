# Optional local overrides. Copy to deploy/.env and never commit that file.

# Spring server
APP_IMAGE=bidwin-back:local
SERVER_BIND_ADDRESS=127.0.0.1
SERVER_PORT=8080
MANAGEMENT_BIND_ADDRESS=127.0.0.1
MANAGEMENT_PORT=9292
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError

MYSQL_DATABASE=bidwin
MYSQL_USER=bidwin
MYSQL_PASSWORD=bidwin-local
MYSQL_ROOT_PASSWORD=root-local
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3307

# Redis (입찰가 캐시)
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

# Data retention
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=2d
PROMETHEUS_RETENTION_SIZE=512MB

# Mail
MAIL_USERNAME=
MAIL_PASSWORD=
PASSWORD_RESET_URL=http://localhost:5173/password-reset/confirm
EMAIL_VERIFICATION_URL=http://localhost:5173/email-verification

# Session and AWS
SESSION_COOKIE_SECURE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=bidwin-local
AWS_REGION=ap-northeast-2
AWS_CLOUDFRONT_DOMAIN=http://localhost:8080
